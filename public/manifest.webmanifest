    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Review", "short_name": "Review", "url": "/review", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tracks", "short_name": "Tracks", "url": "/tracks", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Crates", "short_name": "Crates", "url": "/crates", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
