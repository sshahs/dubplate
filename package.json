{
  "name": "dubplate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "demo": "tsx scripts/demo-library.ts"
  },
  "dependencies": {
    "@audio/decode": "^3.16.1",
    "@hono/node-server": "^2.1.1",
    "cheerio": "^1.2.0",
    "hono": "^4.13.9",
    "jpeg-js": "^0.4.4",
    "music-metadata": "^11.16.1",
    "node-taglib-sharp": "^6.0.3",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^24.19.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "description": "AI-assisted music tagger and renamer for sound-system collections",
  "engines": {
    "node": ">=22.13"
  }
}
