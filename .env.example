# Copy to .env for docker compose (all optional).
# Image tag: latest (main), a release like 1.2.3, or sha-abc1234
DUBPLATE_TAG=latest
MUSIC_DIR=/path/to/your/music
PUID=1000
PGID=1000
DUBPLATE_PORT=4455
# Extra hostnames allowed to reach the UI, comma-separated (e.g. nas.local,192.168.1.20)
DUBPLATE_ALLOWED_HOSTS=
# Time zone for the nightly scan (defaults to UTC)
TZ=Europe/London
# Point at the bundled Ollama service instead of one on the host:
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
COMMANDCODE_API_KEY=
# 1 = force Command Code Zero Data Retention on (otherwise it's a switch in Settings)
CMD_ZDR=
DISCOGS_TOKEN=
LASTFM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
ACOUSTID_API_KEY=
